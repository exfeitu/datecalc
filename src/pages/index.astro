---
// src/pages/index.astro — DateCalc Homepage
import BaseLayout from '../components/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import CategoryCard from '../components/CategoryCard.astro';
import FAQ from '../components/FAQ.astro';
import { homeMeta } from '../lib/meta';
import { webAppSchema, breadcrumbSchema, organizationSchema } from '../lib/schema';

const SITE_URL = 'https://datecalc.vercel.app';
const meta = homeMeta();
const schemas = [
  webAppSchema({ name: 'DateCalc', url: SITE_URL, description: meta.description }),
  breadcrumbSchema([{ name: 'Home', url: SITE_URL }]),
  organizationSchema({ name: 'DateCalc', url: SITE_URL }),
];

const categories = [
  { title: 'Days Between', description: 'Calculate exact days between any two dates.', href: '/days-between/' },
  { title: 'Days From Today', description: 'What date is N days from now? 30, 60, 90 days and more.', href: '/days-from-today/' },
  { title: 'Days Until Events', description: 'Countdown to holidays, seasons, sports, and special days.', href: '/days-until/' },
];

const popularLinks = [
  { label: 'Days until Christmas 2026', href: '/days-until/christmas/2026/' },
  { label: '90 days from today', href: '/days-from-today/90/' },
  { label: 'Days between Jan 1 and Dec 31, 2026', href: '/days-between/2026-01-01/2026-12-31/' },
  { label: 'Days in February (leap year)', href: '/days-in/february/' },
  { label: 'Days until Summer 2027', href: '/days-until/summer/2027/' },
];

const faqItems = [
  {
    question: 'How does DateCalc calculate days between dates?',
    answer: 'DateCalc uses exact calendar arithmetic. Each date is converted to a timestamp, and the absolute difference in milliseconds is divided by 86,400,000 (the number of milliseconds in a day). This gives the precise number of calendar days between any two dates.',
  },
  {
    question: 'Does DateCalc count the start date or end date?',
    answer: 'DateCalc calculates the absolute difference between two dates — the number of 24-hour periods between them. If you enter the same date twice, the result is 0 days. For inclusive counting (including both start and end dates), simply add 1 to the result.',
  },
  {
    question: 'How does DateCalc handle leap years?',
    answer: 'DateCalc automatically accounts for leap years. A leap year occurs every 4 years (except century years not divisible by 400). For example, 2028 is a leap year with 366 days and February 29; 2026 is not a leap year.',
  },
  {
    question: 'Is DateCalc really free?',
    answer: 'Yes, DateCalc is completely free. There are no ads, no registration, and no usage limits. All calculations happen in your browser or at build time — none of your data is ever collected or stored.',
  },
];
---

<BaseLayout title={meta.title} description={meta.description} canonical={SITE_URL} schema={schemas}>
  <section class="home-hero">
    <h1>Date Calculator</h1>
    <p class="home-tagline">Fast, free, no clutter. Just answers.</p>
  </section>

  <Calculator />

  <!-- Category Cards -->
  <section class="home-section">
    <h2 class="home-section-title">Tools</h2>
    <div class="home-grid">
      {categories.map(c => (
        <CategoryCard title={c.title} description={c.description} href={c.href} />
      ))}
    </div>
  </section>

  <!-- Popular Now -->
  <section class="home-section">
    <h2 class="home-section-title">Popular Now</h2>
    <ul class="home-links">
      {popularLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  </section>

  <!-- More Tools -->
  <nav class="home-more" aria-label="More tools">
    <h2 class="home-more-title">More Tools</h2>
    <ul>
      <li><a href="/days-in/">Days in Month / Year</a> <span>&mdash; how many days in each month</span></li>
      <li><a href="/age-in-days/">Age in Days</a> <span>&mdash; calculate your age in days</span></li>
      <li><a href="/days-left-in/2026/">Days Left in 2026</a> <span>&mdash; year progress countdown</span></li>
    </ul>
  </nav>

  <FAQ items={faqItems} />
</BaseLayout>

<style>
  .home-hero {
    text-align: center;
    padding: var(--sp-8) 0 var(--sp-2);
  }

  .home-hero h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: var(--sp-2);
  }

  .home-tagline {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 480px;
    margin: 0 auto;
  }

  /* Sections */
  .home-section {
    margin: var(--sp-8) 0;
  }

  .home-section-title {
    font-size: var(--text-sm);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--sp-4);
  }

  /* Grid */
  .home-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-4);
  }

  /* Popular links */
  .home-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
  }

  .home-links li {
    font-size: var(--text-sm);
  }

  /* More tools */
  .home-more {
    margin: var(--sp-8) 0;
    padding: var(--sp-5);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
  }

  .home-more-title {
    font-size: var(--text-sm);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--sp-3);
  }

  .home-more ul {
    list-style: none;
  }

  .home-more li {
    font-size: var(--text-sm);
    margin-bottom: var(--sp-2);
    color: var(--color-text-secondary);
  }

  .home-more li span {
    color: var(--color-text-tertiary);
  }

  @media (max-width: 640px) {
    .home-hero {
      padding: var(--sp-4) 0 var(--sp-2);
    }

    .home-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
