---
// src/pages/days-until/[event]/[year].astro — Programmatic days-until pages
import BaseLayout from '../../../components/BaseLayout.astro';
import AnswerHero from '../../../components/AnswerHero.astro';
import DateContext from '../../../components/DateContext.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import RelatedQueries from '../../../components/RelatedQueries.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import Timeline from '../../../components/Timeline.astro';
import ShareLink from '../../../components/ShareLink.astro';
import { today, getEventDate, signedDaysBetween, getWeekday } from '../../../lib/dates';
import { daysUntilMeta } from '../../../lib/meta';
import { resultPageSchema } from '../../../lib/schema';
import { isBuilt } from '../../../lib/data/routes';
import { formatDateLong } from '../../../lib/formatters';
import { events, eventYears } from '../../../lib/data/events';

import type { GetStaticPaths } from 'astro';

const SITE_URL = 'https://datecalc-calculator.vercel.app';
const CATEGORY_URL = `${SITE_URL}/days-until/`;

export const getStaticPaths: GetStaticPaths = () => {
  const paths: { params: { event: string; year: string } }[] = [];
  for (const event of events) {
    for (const year of eventYears) {
      if (event.slug === 'leap-day' && year !== 2028) continue;
      paths.push({ params: { event: event.slug, year: String(year) } });
    }
  }
  return paths;
};

const { event, year } = Astro.params as { event: string; year: string };
const eventYear = parseInt(year);

const eventData = events.find(e => e.slug === event);
if (!eventData) {
  Astro.response.status = 404;
}

const eventDate = getEventDate(eventData!, eventYear);
const todayStr = today();
const days = signedDaysBetween(todayStr, eventDate);
const absDays = Math.abs(days);
const weekday = getWeekday(eventDate);

const isFuture = days >= 0;
const verb = isFuture ? 'until' : 'since';
const daysText = isFuture ? `${absDays} day${absDays === 1 ? '' : 's'} until` : `${absDays} day${absDays === 1 ? '' : 's'} since`;

const meta = daysUntilMeta(eventData!.name, eventYear, absDays, eventDate, isFuture ? 'until' : 'since');
const pageUrl = `${SITE_URL}/days-until/${event}/${year}/`;

const nextYear = eventYear + 1;
const hasNextYear = eventYears.includes(nextYear);

const weeks = Math.floor(absDays / 7);
const remDays = absDays % 7;

const subtitle = isFuture
  ? `That's ${weeks} week${weeks === 1 ? '' : 's'}${remDays > 0 ? ` and ${remDays} day${remDays === 1 ? '' : 's'}` : ''} from now`
  : `That was ${weeks} week${weeks === 1 ? '' : 's'}${remDays > 0 ? ` and ${remDays} day${remDays === 1 ? '' : 's'}` : ''} ago`;

// Related events from the same category — nearest countdowns silo the event cluster
const relatedEvents = events
  .filter(e => e.category === eventData!.category && e.slug !== event && e.slug !== 'leap-day')
  .map(e => {
    const ed = getEventDate(e, eventYear);
    const d = signedDaysBetween(todayStr, ed);
    return { e, d };
  })
  .sort((a, b) => Math.abs(a.d) - Math.abs(b.d))
  .slice(0, 4)
  .map(({ e, d }) => ({
    href: `/days-until/${e.slug}/${eventYear}/`,
    label: `Days ${d >= 0 ? 'until' : 'since'} ${e.name} ${eventYear}`,
  }));

const relatedLinks = [
  ...relatedEvents,
  { href: `/days-between/${todayStr}/${eventDate}/`, label: `Days between today and ${eventData!.name} ${eventYear}` },
  ...(hasNextYear ? [{ href: `/days-until/${event}/${nextYear}/`, label: `Days until ${eventData!.name} ${nextYear} →` }] : []),
  { href: `/days-in/${eventYear}/`, label: `Total days in ${eventYear}` },
  { href: `/days-left-in/${eventYear}/`, label: `Days left in ${eventYear}` },
  { href: '/age-in-days/', label: 'Age in days calculator →' },
  { href: '/days-until/', label: 'More days until events →' },
  { href: '/days-from-today/', label: 'Days from today calculator →' },
].filter(l => isBuilt(l.href));

const faqs = [
  {
    question: `How many days ${verb} ${eventData!.name} ${eventYear}?`,
    answer: `There ${isFuture ? 'are' : 'were'} ${absDays} day${absDays === 1 ? '' : 's'} ${verb} ${eventData!.name} ${eventYear}. ${eventData!.name} ${isFuture ? 'falls' : 'fell'} on ${formatDateLong(eventDate)} (${weekday}).`,
  },
  {
    question: `What day of the week is ${eventData!.name} ${eventYear}?`,
    answer: `${eventData!.name} ${eventYear} is on a ${weekday} (${formatDateLong(eventDate)}).`,
  },
  {
    question: `How many weeks ${verb} ${eventData!.name} ${eventYear}?`,
    answer: `There ${isFuture ? 'are' : 'were'} ${weeks} week${weeks === 1 ? '' : 's'}${remDays > 0 ? ` and ${remDays} day${remDays === 1 ? '' : 's'}` : ''} ${verb} ${eventData!.name} ${eventYear}.`,
  },
  {
    question: `When exactly is ${eventData!.name} ${eventYear}?`,
    answer: `${eventData!.name} ${eventYear} is on ${formatDateLong(eventDate)}. ${isFuture ? 'Mark your calendar!' : 'It has already passed this year.'}`,
  },
];

const schemas = [
  resultPageSchema({ title: meta.title, description: meta.description, url: pageUrl, faqs }),
];
---

<BaseLayout title={meta.title} description={meta.description} canonical={pageUrl} schema={schemas}>
  <Breadcrumb items={[
    { name: 'Home', url: SITE_URL },
    { name: 'Days Until', url: CATEGORY_URL },
    { name: `${eventData!.name} ${eventYear}`, url: pageUrl },
  ]} />

  <AnswerHero
    value={absDays}
    unit={`days ${verb}`}
    heading={`How many days ${verb} ${eventData!.name} ${eventYear}?`}
    subtitle={subtitle}
  />

  <DateContext date1={isFuture ? todayStr : eventDate} date2={isFuture ? eventDate : todayStr} days={absDays} />

  <KeyFacts days={absDays} weeks={weeks} remDays={remDays} />

  <p class="exp">
    {isFuture ? (
      <>There are <strong>{absDays} day{absDays === 1 ? '' : 's'}</strong> until{' '}
        <strong>{eventData!.name} {eventYear}</strong>, which falls on{' '}
        {formatDateLong(eventDate)} ({weekday}).
        That's {weeks} week{weeks === 1 ? '' : 's'}
        {remDays > 0 && <span> and {remDays} day{remDays === 1 ? '' : 's'}</span>} from today
        ({formatDateLong(todayStr)}).</>
    ) : (
      <>{eventData!.name} {eventYear} was <strong>{absDays} day{absDays === 1 ? '' : 's'} ago</strong> — it fell on{' '}
        {formatDateLong(eventDate)} ({weekday}).
        That was {weeks} week{weeks === 1 ? '' : 's'}
        {remDays > 0 && <span> and {remDays} day{remDays === 1 ? '' : 's'}</span>} before today.</>
    )}
  </p>

  <Timeline date1={isFuture ? todayStr : eventDate} date2={isFuture ? eventDate : todayStr} days={absDays} />

  <ShareLink url={pageUrl} />

  <RelatedQueries links={relatedLinks} />
</BaseLayout>

<style>
  .exp {
    max-width: 600px;
    margin: 0 auto var(--sp-4);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    text-align: center;
    line-height: 1.75;
  }

  .exp strong {
    color: var(--color-text);
    font-weight: 650;
  }
</style>
