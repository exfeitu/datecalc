---
// src/pages/404.astro — Custom 404 Not Found page
import BaseLayout from '../components/BaseLayout.astro';

const SITE_URL = 'https://datecalc.vercel.app';
const meta = {
  title: `Page Not Found — 404 | DateCalc`,
  description: 'The page you are looking for does not exist. Try our free date calculators instead.',
};
---

<BaseLayout title={meta.title} description={meta.description} canonical={`${SITE_URL}/404/`} schema={[]}>
  <div class="not-found">
    <span class="nf-code">404</span>
    <h1>Page Not Found</h1>
    <p class="nf-desc">The page you're looking for doesn't exist. It may have moved, or the URL might have a typo.</p>
    <div class="nf-links">
      <h2>Try These Tools</h2>
      <ul>
        <li><a href="/">Home — Date Calculator</a></li>
        <li><a href="/days-between/">Days Between Dates</a></li>
        <li><a href="/days-from-today/">Days From Today</a></li>
        <li><a href="/days-until/">Days Until Events</a></li>
        <li><a href="/days-in/">Days In Month / Year</a></li>
        <li><a href="/age-in-days/">Age in Days</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: var(--sp-12) 0;
  }

  .nf-code {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    opacity: 0.12;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  h1 {
    margin-top: -2rem;
    margin-bottom: var(--sp-3);
  }

  .nf-desc {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    max-width: 400px;
    margin: 0 auto var(--sp-8);
  }

  .nf-links {
    padding: var(--sp-5);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    max-width: 360px;
    margin: 0 auto;
  }

  .nf-links h2 {
    font-size: var(--text-sm);
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--sp-3);
  }

  .nf-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .nf-links li {
    font-size: var(--text-sm);
  }
</style>
