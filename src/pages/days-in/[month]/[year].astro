---
// src/pages/days-in/[month]/[year].astro — Programmatic "days in [month] [year]" pages
// Covers the month×year grid (e.g. /days-in/february/2028/) that the single-level
// [slug].astro route can't (it anchors months to 2026).
import BaseLayout from '../../../components/BaseLayout.astro';
import AnswerHero from '../../../components/AnswerHero.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import RelatedQueries from '../../../components/RelatedQueries.astro';
import KeyFacts from '../../../components/KeyFacts.astro';
import ShareLink from '../../../components/ShareLink.astro';
import { isLeapYear, daysInMonth, getWeekday } from '../../../lib/dates';
import { daysInMonthMeta } from '../../../lib/meta';
import { resultPageSchema } from '../../../lib/schema';
import { months, yearRange } from '../../../lib/data/months';

import type { GetStaticPaths } from 'astro';

const SITE_URL = 'https://datecalc-calculator.vercel.app';
const CATEGORY_URL = `${SITE_URL}/days-in/`;

export const getStaticPaths: GetStaticPaths = () => {
  const paths: { params: { month: string; year: string } }[] = [];
  for (const m of months) {
    for (const y of yearRange) {
      paths.push({ params: { month: m.slug, year: String(y) } });
    }
  }
  return paths;
};

const { month, year } = Astro.params as { month: string; year: string };
const monthData = months.find(m => m.slug === month);
const yearNum = parseInt(year);
const validYear = yearRange.includes(yearNum);

if (!monthData || !validYear) {
  Astro.response.status = 404;
}

const days = monthData && validYear ? daysInMonth(yearNum, monthData.index) : 0;
const isLeap = isLeapYear(yearNum);
const isFeb = monthData?.index === 2;

// Real calendar data (computed at build time): weekday distribution for this month.
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const monthStr = monthData && validYear ? String(monthData.index).padStart(2, '0') : '';
const firstDate = monthData && validYear ? `${yearNum}-${monthStr}-01` : '';
const weekdayCounts = monthData && validYear
  ? WEEKDAYS.map(name => ({
      name,
      count: Array.from({ length: days }, (_, i) => i + 1)
        .filter(d => getWeekday(`${yearNum}-${monthStr}-${String(d).padStart(2, '0')}`) === name).length,
    }))
  : [];
const firstWeekday = firstDate ? getWeekday(firstDate) : '';
const lastWeekday = monthData && validYear ? getWeekday(`${yearNum}-${monthStr}-${String(days).padStart(2, '0')}`) : '';
const satCount = weekdayCounts.find(w => w.name === 'Saturday')?.count ?? 0;
const sunCount = weekdayCounts.find(w => w.name === 'Sunday')?.count ?? 0;
const weekendCount = satCount + sunCount;
const workdayCount = days - weekendCount;
const topWeekday = weekdayCounts.length ? [...weekdayCounts].sort((a, b) => b.count - a.count)[0] : null;

const meta = monthData && validYear
  ? daysInMonthMeta(monthData.name, days, yearNum, firstWeekday)
  : { title: 'Not Found', description: '' };

const pageUrl = `${SITE_URL}/days-in/${month}/${year}/`;
const totalWeeks = Math.floor(days / 7);
const remDays = days % 7;

const subtitle = isFeb
  ? `${yearNum} is ${isLeap ? 'a leap year, so February has 29 days' : 'not a leap year, so February has 28 days'}`
  : `${monthData?.name} ${yearNum} has ${days} days`;

const faqs = monthData && validYear
  ? [
      {
        question: `How many days in ${monthData.name} ${yearNum}?`,
        answer: `${monthData.name} ${yearNum} has ${days} day${days === 1 ? '' : 's'}.${isFeb ? ` ${yearNum} is ${isLeap ? 'a leap year' : 'not a leap year'}, so February has ${days} days.` : ` ${monthData.name} always has ${days} days every year.`}`,
      },
      {
        question: `Is ${yearNum} a leap year?`,
        answer: isLeap
          ? `Yes, ${yearNum} is a leap year (366 days), so February has 29 days.`
          : `No, ${yearNum} is not a leap year (365 days), so February has 28 days.`,
      },
      {
        question: `How many weekends are in ${monthData.name} ${yearNum}?`,
        answer: `${monthData.name} ${yearNum} has ${weekendCount} weekend days (${satCount} Saturdays and ${sunCount} Sundays) and ${workdayCount} weekdays.`,
      },
      {
        question: `What day of the week does ${monthData.name} ${yearNum} start on?`,
        answer: `${monthData.name} 1, ${yearNum} is a ${firstWeekday}. The month ends on a ${lastWeekday}.`,
      },
      topWeekday
        ? {
            question: `How many ${topWeekday.name}s are in ${monthData.name} ${yearNum}?`,
            answer: `${monthData.name} ${yearNum} has ${topWeekday.count} ${topWeekday.name}s.`,
          }
        : null,
    ].filter(Boolean) as { question: string; answer: string }[]
  : [];

const relatedLinks = monthData && validYear
  ? [
      ...yearRange.filter(y => y !== yearNum).map(y => ({
        href: `/days-in/${month}/${y}/`,
        label: `Days in ${monthData.name} ${y}`,
      })),
      { href: `/days-in/${month}/`, label: `Days in ${monthData.name} (2026)` },
      { href: `/days-in/${yearNum}/`, label: `Days in ${yearNum} (full year)` },
      { href: '/days-in/', label: 'All months →' },
    ]
  : [];

const schemas = monthData && validYear
  ? [resultPageSchema({ title: meta.title, description: meta.description, url: pageUrl, faqs })]
  : [];
---

{monthData && validYear ? (
  <BaseLayout title={meta.title} description={meta.description} canonical={pageUrl} schema={schemas}>
    <Breadcrumb items={[
      { name: 'Home', url: SITE_URL },
      { name: 'Days In', url: CATEGORY_URL },
      { name: `${monthData.name} ${yearNum}`, url: pageUrl },
    ]} />

    <AnswerHero
      value={days}
      unit={`days in ${monthData.name} ${yearNum}`}
      heading={`How many days in ${monthData.name} ${yearNum}?`}
      subtitle={subtitle}
    />

    <p class="exp">
      <strong>{monthData.name} {yearNum}</strong> has <strong>{days} day{days === 1 ? '' : 's'}</strong>.
      {isFeb
        ? ` ${yearNum} is ${isLeap ? 'a leap year (February has 29 days)' : 'not a leap year (February has 28 days)'}.`
        : ` ${monthData.name} has ${days} days every year.`}
      {' '}{yearNum} has {isLeap ? '366 days in total' : '365 days in total'}.
    </p>

    <section class="mg" aria-label={`${monthData.name} ${yearNum} at a glance`}>
      <h2 class="mg-title kicker">Month at a Glance</h2>
      <p class="mg-bounds">
        {monthData.name} {yearNum} starts on a <strong>{firstWeekday}</strong> and ends on a <strong>{lastWeekday}</strong>.
        It has <strong>{weekendCount} weekend days</strong> and <strong>{workdayCount} weekdays</strong>.
      </p>
      <ul class="mg-grid">
        {weekdayCounts.map(w => (
          <li class="mg-item">
            <span class="mg-day">{w.name.slice(0, 3)}</span>
            <span class="mg-count num">{w.count}</span>
          </li>
        ))}
      </ul>
    </section>

    <KeyFacts days={days} weeks={totalWeeks} remDays={remDays} />

    <ShareLink url={pageUrl} />

    <RelatedQueries links={relatedLinks} />
  </BaseLayout>
) : (
  <BaseLayout title="Not Found" description="" canonical={pageUrl} schema={[]}>
    <h1>Page Not Found</h1>
    <p>This page does not exist. <a href="/days-in/">Browse all days in months</a>.</p>
  </BaseLayout>
)}

<style>
  .exp {
    max-width: 600px;
    margin: 0 auto var(--sp-4);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    text-align: center;
    line-height: 1.75;
  }

  .exp strong {
    color: var(--color-text);
    font-weight: 650;
  }

  /* Month at a Glance — weekday distribution, computed at build time */
  .mg {
    margin: var(--sp-8) 0;
    padding: var(--sp-6);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  .mg-title {
    margin-bottom: var(--sp-4);
    text-align: center;
    color: var(--color-text-tertiary);
  }

  .mg-bounds {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--sp-4);
  }

  .mg-bounds strong {
    color: var(--color-text);
    font-weight: 650;
  }

  .mg-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--sp-2);
  }

  .mg-item {
    text-align: center;
    padding: var(--sp-3) var(--sp-1);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    border-top: 2px solid var(--color-accent);
  }

  .mg-day {
    display: block;
    font-size: var(--text-xs);
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--sp-1);
  }

  .mg-count {
    font-size: var(--text-xl);
    font-weight: 750;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .mg {
      padding: var(--sp-4);
    }

    .mg-grid {
      gap: var(--sp-1);
    }

    .mg-count {
      font-size: var(--text-base);
    }
  }
</style>
