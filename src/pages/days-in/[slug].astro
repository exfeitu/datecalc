---
// src/pages/days-in/[slug].astro — Programmatic days-in pages (months + years)
import BaseLayout from '../../components/BaseLayout.astro';
import AnswerHero from '../../components/AnswerHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import DateContext from '../../components/DateContext.astro';
import RelatedQueries from '../../components/RelatedQueries.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import Timeline from '../../components/Timeline.astro';
import ShareLink from '../../components/ShareLink.astro';
import { isLeapYear, daysInMonth, getWeekday } from '../../lib/dates';
import { daysInYearMeta } from '../../lib/meta';
import { resultPageSchema } from '../../lib/schema';
import { months } from '../../lib/data/months';
import { yearRange } from '../../lib/data/months';

import type { GetStaticPaths } from 'astro';

const SITE_URL = 'https://datecalc-calculator.vercel.app';
const CATEGORY_URL = `${SITE_URL}/days-in/`;
const baseYear = 2026;
const WEEKDAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

export const getStaticPaths: GetStaticPaths = () => {
  const paths: { params: { slug: string } }[] = [];
  // Month slugs
  for (const m of months) {
    paths.push({ params: { slug: m.slug } });
  }
  // Year numbers
  for (const y of yearRange) {
    paths.push({ params: { slug: String(y) } });
  }
  return paths;
};

const { slug } = Astro.params as { slug: string };

// Determine if it's a month or year
const monthData = months.find(m => m.slug === slug);
const yearNum = parseInt(slug);
const isYear = !isNaN(yearNum) && String(yearNum) === slug && yearNum >= 1900 && yearNum <= 2100;

let days: number;
let title: string;
let description: string;
let unit: string;
let subtitle: string;
let explanation: string;
let faqs: { question: string; answer: string }[];
let relatedLinks: { href: string; label: string }[];
let contextLabel: string; // for breadcrumb

// Month at a Glance — real calendar data for the 2026-anchored month pages,
// mirroring the [month]/[year] template. Null for year pages (no glance block).
let glance: {
  firstWeekday: string;
  lastWeekday: string;
  weekendCount: number;
  workdayCount: number;
  topWeekday: { name: string; count: number };
  weekdayCounts: { name: string; count: number }[];
} | null = null;

if (isYear) {
  const isLeap = isLeapYear(yearNum);
  days = isLeap ? 366 : 365;
  const meta = daysInYearMeta(yearNum, days, isLeap);
  title = meta.title;
  description = meta.description;
  unit = `days in ${yearNum}`;
  subtitle = `${yearNum} is ${isLeap ? 'a leap year' : 'not a leap year'}`;
  explanation = `<strong>${yearNum}</strong> has <strong>${days} days</strong>. ${yearNum} is ${isLeap ? 'a leap year (divisible by 4, and not a century year unless divisible by 400)' : 'not a leap year'}. A standard year has 365 days; leap years add February 29 for a total of 366 days.`;
  contextLabel = `Days in ${yearNum}`;
  faqs = [
    {
      question: `How many days in ${yearNum}?`,
      answer: `${yearNum} has ${days} days. It is ${isLeap ? 'a leap year' : 'not a leap year'}.${isLeap ? ' Leap years have 366 days with February 29.' : ' Non-leap years have 365 days.'}`,
    },
    {
      question: `Is ${yearNum} a leap year?`,
      answer: isLeap ? `Yes, ${yearNum} is a leap year. It has 366 days with February 29.` : `No, ${yearNum} is not a leap year. It has 365 days.`,
    },
  ];
  relatedLinks = [
    ...yearRange.filter(y => y !== yearNum).slice(0, 5).map(y => ({
      href: `/days-in/${y}/`,
      label: `Days in ${y}`,
    })),
    ...months.map(m => ({
      href: `/days-in/${m.slug}/${yearNum}/`,
      label: `Days in ${m.name} ${yearNum}`,
    })),
    { href: '/days-in/', label: 'Days in months →' },
  ];
} else if (monthData) {
  days = daysInMonth(baseYear, monthData.index);
  const isFeb = monthData.index === 2;
  const isCurrentLeap = isLeapYear(baseYear);

  // Real calendar data for the Month at a Glance block (2026-anchored)
  const monthStr = String(monthData.index).padStart(2, '0');
  const firstDate = `${baseYear}-${monthStr}-01`;
  const firstWeekday = getWeekday(firstDate);
  const lastWeekday = getWeekday(`${baseYear}-${monthStr}-${String(days).padStart(2, '0')}`);
  const weekdayCounts = WEEKDAYS.map(name => ({
    name,
    count: Array.from({ length: days }, (_, i) => i + 1)
      .filter(d => getWeekday(`${baseYear}-${monthStr}-${String(d).padStart(2, '0')}`) === name).length,
  }));
  const satCount = weekdayCounts.find(w => w.name === 'Saturday')?.count ?? 0;
  const sunCount = weekdayCounts.find(w => w.name === 'Sunday')?.count ?? 0;
  const weekendCount = satCount + sunCount;
  const workdayCount = days - weekendCount;
  const topWeekday = [...weekdayCounts].sort((a, b) => b.count - a.count)[0];
  glance = { firstWeekday, lastWeekday, weekendCount, workdayCount, topWeekday, weekdayCounts };

  // Anchor month page is year-agnostic (URL has no year) — title/desc must
  // not duplicate the /days-in/{month}/{year}/ pages.
  title = `How Many Days in ${monthData.name}? | DateCalc`;
  description = isFeb
    ? `February has ${days} days in ${baseYear} (${isCurrentLeap ? 'a leap year' : 'not a leap year'}). It starts on a ${firstWeekday}, ends on a ${lastWeekday}, and has ${weekendCount} weekend days that year. Free from DateCalc.`
    : `${monthData.name} always has ${days} days, no matter the year. In ${baseYear} it starts on a ${firstWeekday}, ends on a ${lastWeekday}, and has ${weekendCount} weekend days. Free from DateCalc.`;
  unit = `days in ${monthData.name}`;
  subtitle = isFeb
    ? `${baseYear} is ${isCurrentLeap ? 'a leap year' : 'not a leap year'}, so February has ${days} days`
    : `${monthData.name} always has ${days} days`;
  explanation = `<strong>${monthData.name} ${baseYear}</strong> has <strong>${days} day${days === 1 ? '' : 's'}</strong>.${isFeb ? ` ${baseYear} is ${isCurrentLeap ? 'a leap year (February has 29 days)' : 'not a leap year (February has 28 days)'}.` : ` ${monthData.name} has ${days} days every year — it's always consistent.`}`;
  contextLabel = `Days in ${monthData.name}`;
  faqs = [
    {
      question: `How many days in ${monthData.name} ${baseYear}?`,
      answer: `${monthData.name} ${baseYear} has ${days} day${days === 1 ? '' : 's'}.${isFeb ? ` ${baseYear} is ${isCurrentLeap ? 'a leap year' : 'not a leap year'}, so February has ${days} days.` : ` ${monthData.name} always has ${days} days.`}`,
    },
    {
      question: `Is ${monthData.name} a 30 or 31 day month?`,
      answer: days === 31 ? `${monthData.name} has 31 days.` : days === 30 ? `${monthData.name} has 30 days.` : `February has ${days} days in ${baseYear} (${isCurrentLeap ? 'leap year' : 'non-leap year'}).`,
    },
    {
      question: `How many weekends are in ${monthData.name} ${baseYear}?`,
      answer: `${monthData.name} ${baseYear} has ${weekendCount} weekend days (${satCount} Saturdays and ${sunCount} Sundays) and ${workdayCount} weekdays.`,
    },
    {
      question: `What day of the week does ${monthData.name} ${baseYear} start on?`,
      answer: `${monthData.name} 1, ${baseYear} is a ${firstWeekday}. The month ends on a ${lastWeekday}.`,
    },
    topWeekday
      ? {
          question: `How many ${topWeekday.name}s are in ${monthData.name} ${baseYear}?`,
          answer: `${monthData.name} ${baseYear} has ${topWeekday.count} ${topWeekday.name}s.`,
        }
      : null,
  ].filter(Boolean) as { question: string; answer: string }[];
  relatedLinks = [
    ...months.filter(m => m.index !== monthData.index).slice(0, 5).map(m => ({
      href: `/days-in/${m.slug}/`,
      label: `Days in ${m.name} ${baseYear}`,
    })),
    ...yearRange.filter(y => y !== baseYear).map(y => ({
      href: `/days-in/${monthData.slug}/${y}/`,
      label: `Days in ${monthData.name} ${y}`,
    })),
    { href: `/days-in/${baseYear}/`, label: `Days in ${baseYear} (full year)` },
    { href: '/days-in/', label: 'All months →' },
  ];
} else {
  // 404 fallback
  Astro.response.status = 404;
  days = 0;
  title = 'Not Found';
  description = '';
  unit = '';
  subtitle = '';
  explanation = '';
  contextLabel = '';
  faqs = [];
  relatedLinks = [];
}

const pageUrl = `${SITE_URL}/days-in/${slug}/`;
const totalWeeks = Math.floor(days / 7);
const remDays = days % 7;

// Date span for the timeline/context: year pages span Jan 1–Dec 31,
// month pages span the 1st to the last day of that month.
const spanDate1 = isYear ? `${yearNum}-01-01` : (monthData ? `${baseYear}-${String(monthData.index).padStart(2, '0')}-01` : '');
const spanDate2 = isYear ? `${yearNum}-12-31` : (monthData ? `${baseYear}-${String(monthData.index).padStart(2, '0')}-${String(days).padStart(2, '0')}` : '');

const schemas = [
  resultPageSchema({ title, description, url: pageUrl, faqs }),
];
---

{isYear || monthData ? (
  <BaseLayout title={title} description={description} canonical={pageUrl} schema={schemas}>
    <Breadcrumb items={[
      { name: 'Home', url: SITE_URL },
      { name: 'Days In', url: CATEGORY_URL },
      { name: contextLabel, url: pageUrl },
    ]} />

    <AnswerHero
      value={days}
      unit={unit}
      heading={isYear ? `How many days in ${yearNum}?` : `How many days in ${monthData!.name}?`}
      subtitle={subtitle}
    />

    <p class="exp" set:html={explanation} />

    {glance ? (
      <section class="mg" aria-label={`${monthData!.name} ${baseYear} at a glance`}>
        <h2 class="mg-title kicker">Month at a Glance</h2>
        <p class="mg-bounds">
          {monthData!.name} {baseYear} starts on a <strong>{glance.firstWeekday}</strong> and ends on a <strong>{glance.lastWeekday}</strong>.
          It has <strong>{glance.weekendCount} weekend days</strong> and <strong>{glance.workdayCount} weekdays</strong>.
        </p>
        <ul class="mg-grid">
          {glance.weekdayCounts.map(w => (
            <li class="mg-item">
              <span class="mg-day">{w.name.slice(0, 3)}</span>
              <span class="mg-count num">{w.count}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <KeyFacts days={days} weeks={totalWeeks} remDays={remDays} />

    {spanDate1 && spanDate2 && (
      <>
        <DateContext date1={spanDate1} date2={spanDate2} days={days} />
        <Timeline date1={spanDate1} date2={spanDate2} days={days} />
      </>
    )}

    <ShareLink url={pageUrl} />

    <RelatedQueries links={relatedLinks} />
  </BaseLayout>
) : (
  <BaseLayout title="Not Found" description="" canonical={pageUrl} schema={[]}>
    <h1>Page Not Found</h1>
    <p>This page does not exist. <a href="/days-in/">Browse all days in months</a>.</p>
  </BaseLayout>
)}

<style>
  .exp {
    max-width: 600px;
    margin: 0 auto var(--sp-4);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    text-align: center;
    line-height: 1.75;
  }

  .exp :global(strong) {
    color: var(--color-text);
    font-weight: 650;
  }

  /* Month at a Glance — weekday distribution, computed at build time */
  .mg {
    margin: var(--sp-8) 0;
    padding: var(--sp-6);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  .mg-title {
    margin-bottom: var(--sp-4);
    text-align: center;
    color: var(--color-text-tertiary);
  }

  .mg-bounds {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--sp-4);
  }

  .mg-bounds strong {
    color: var(--color-text);
    font-weight: 650;
  }

  .mg-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--sp-2);
  }

  .mg-item {
    text-align: center;
    padding: var(--sp-3) var(--sp-1);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    border-top: 2px solid var(--color-accent);
  }

  .mg-day {
    display: block;
    font-size: var(--text-xs);
    font-weight: 500;
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: var(--sp-1);
  }

  .mg-count {
    font-size: var(--text-xl);
    font-weight: 750;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .mg {
      padding: var(--sp-4);
    }

    .mg-grid {
      gap: var(--sp-1);
    }

    .mg-count {
      font-size: var(--text-base);
    }
  }
</style>
