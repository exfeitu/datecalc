---
// Footer.astro — site footer
---
<footer class="sf">
  <nav aria-label="Footer navigation" class="sf-links">
    <a href="/">Home</a>
    <a href="/about/">About</a>
    <a href="/privacy/">Privacy</a>
    <a href="/sitemap-index.xml">Sitemap</a>
  </nav>
  <p class="sf-copy">&copy; {new Date().getFullYear()} DateCalc. All dates based on UTC.</p>
</footer>

<style>
  .sf {
    margin-top: var(--sp-12);
    padding: var(--sp-6) 0;
    border-top: 1px solid var(--color-border-light);
    text-align: center;
  }

  .sf-links {
    display: flex;
    justify-content: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
    margin-bottom: var(--sp-3);
  }

  .sf-links a,
  .sf-copy {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .sf-links a:hover {
    color: var(--color-accent);
  }
</style>
