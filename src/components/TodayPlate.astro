---
// TodayPlate.astro — compact "today" instrument strip: date + day-of-year + year progress.
// All computed at build time (SSG) — zero JS on the page. Rebuilds fresh each deploy.
import { today, getWeekday, isLeapYear, daysInMonth, daysLeftInYear } from '../lib/dates';
import { formatDateLong } from '../lib/formatters';

const now = today(); // YYYY-MM-DD
const [yearStr, monthStr, dayStr] = now.split('-');
const year = Number(yearStr);
const monthIdx = Number(monthStr); // 1-12
const day = Number(dayStr);

const weekday = getWeekday(now);
const dateLong = formatDateLong(now);

// Day of year + year progress
let doy = day;
for (let m = 1; m < monthIdx; m++) doy += daysInMonth(year, m);
const totalDays = isLeapYear(year) ? 366 : 365;
const pct = Math.round((doy / totalDays) * 100);
const left = Math.max(0, daysLeftInYear(year));
---

<div class="today" aria-label={`Today is ${weekday}, ${dateLong}`}>
  <span class="today-kicker kicker">Today</span>
  <span class="today-date">{weekday}, {dateLong}</span>
  <span class="today-doy">
    Day <strong>{doy}</strong><span class="today-total"> / {totalDays}</span>
  </span>
  <div class="today-progress">
    <div class="today-bar" role="img" aria-label={`${pct}% of ${year} has elapsed`}>
      <span class="today-fill" style={`width: ${pct}%`}></span>
      <span class="today-needle" style={`left: ${pct}%`}></span>
    </div>
    <span class="today-meta">{pct}% · {left} day{left === 1 ? '' : 's'} left in {year}</span>
  </div>
</div>

<style>
  .today {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    max-width: 560px;
    margin: var(--sp-4) auto var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
    text-align: left;
  }

  .today-kicker {
    color: var(--color-accent);
  }

  .today-date {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .today-doy {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
  }

  .today-doy strong {
    font-weight: 700;
    color: var(--color-text);
  }

  .today-total {
    color: var(--color-text-tertiary);
    font-weight: 500;
  }

  .today-progress {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .today-bar {
    position: relative;
    width: 120px;
    height: 8px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: visible;
  }

  .today-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    min-width: 0;
  }

  /* needle echoing the AnswerHero ruler marker */
  .today-needle {
    position: absolute;
    top: -3px;
    bottom: -3px;
    width: 2px;
    background: var(--color-accent);
  }

  .today-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .today {
      gap: var(--sp-2) var(--sp-3);
      padding: var(--sp-3) 0;
      justify-content: flex-start;
    }

    .today-bar {
      width: 96px;
    }
  }
</style>
