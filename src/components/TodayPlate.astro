---
// TodayPlate.astro — "today" instrument card: mini calendar + year progress.
// All computed at build time (SSG) — zero JS on the page. Rebuilds fresh each deploy.
import { today, getWeekday, isLeapYear, daysInMonth, daysLeftInYear } from '../lib/dates';
import { formatDateLong } from '../lib/formatters';
import { months } from '../lib/data/months';

const now = today(); // YYYY-MM-DD
const [yearStr, monthStr, dayStr] = now.split('-');
const year = Number(yearStr);
const monthIdx = Number(monthStr); // 1-12
const day = Number(dayStr);

const monthName = months.find(m => m.index === monthIdx)!.name;
const weekday = getWeekday(now);
const dateLong = formatDateLong(now);

// Calendar grid — Sunday-first (JS getDay(): 0 = Sunday)
const daysThisMonth = daysInMonth(year, monthIdx);
const firstWeekday = new Date(Date.UTC(year, monthIdx - 1, 1, 12)).getDay();
const DOWS = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
const cells: (number | null)[] = [];
for (let i = 0; i < firstWeekday; i++) cells.push(null);
for (let d = 1; d <= daysThisMonth; d++) cells.push(d);

// Day of year + year progress
let doy = day;
for (let m = 1; m < monthIdx; m++) doy += daysInMonth(year, m);
const totalDays = isLeapYear(year) ? 366 : 365;
const pct = Math.round((doy / totalDays) * 100);
const left = Math.max(0, daysLeftInYear(year));
---

<div class="today" aria-label={`Today is ${weekday}, ${dateLong}`}>
  <div class="today-head">
    <span class="today-kicker kicker">Today</span>
    <span class="today-date">{weekday}, {dateLong}</span>
  </div>

  <div class="today-body">
    <div class="today-cal">
      <p class="today-month">{monthName} {year}</p>
      <div class="today-grid">
        {DOWS.map(w => (
          <span class="today-dow">{w}</span>
        ))}
        {cells.map((c, i) =>
          c === null ? (
            <span class="today-cell today-empty" aria-hidden="true"></span>
          ) : (
            <span
              class:list={['today-cell', c === day ? 'today-now' : '']}
              aria-current={c === day ? 'date' : undefined}
            >{c}</span>
          ),
        )}
      </div>
    </div>

    <div class="today-year">
      <p class="today-mono">Day {doy} of {totalDays}</p>
      <div class="today-bar" role="img" aria-label={`${pct}% of ${year} has elapsed`}>
        <span class="today-fill" style={`width: ${pct}%`}></span>
        <span class="today-needle" style={`left: ${pct}%`}></span>
      </div>
      <p class="today-mono-sub">{left} day{left === 1 ? '' : 's'} remaining in {year}</p>
    </div>
  </div>
</div>

<style>
  .today {
    max-width: 560px;
    margin: var(--sp-6) auto 0;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: var(--sp-5) var(--sp-6);
    text-align: left;
  }

  .today-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3);
    border-bottom: 1px solid var(--color-border-light);
    padding-bottom: var(--sp-3);
  }

  .today-date {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .today-body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-6);
    align-items: center;
    padding-top: var(--sp-4);
  }

  .today-month {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--sp-2);
    text-align: center;
  }

  .today-grid {
    display: grid;
    grid-template-columns: repeat(7, 1.6rem);
    gap: 2px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .today-dow {
    text-align: center;
    color: var(--color-text-tertiary);
    font-weight: 700;
    padding: 2px 0;
  }

  .today-cell {
    display: grid;
    place-items: center;
    height: 1.6rem;
    color: var(--color-text-secondary);
    border-radius: var(--radius-xs);
  }

  .today-empty {
    visibility: hidden;
  }

  .today-now {
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
    box-shadow: 0 0 0 3px var(--color-accent-glow);
  }

  .today-year {
    border-left: 1px solid var(--color-border-light);
    padding-left: var(--sp-5);
  }

  .today-mono {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text);
    font-feature-settings: 'tnum';
    font-variant-numeric: tabular-nums;
  }

  .today-bar {
    position: relative;
    height: 10px;
    margin: var(--sp-3) 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: visible;
  }

  .today-fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    min-width: 0;
  }

  /* needle echoing the AnswerHero ruler marker */
  .today-needle {
    position: absolute;
    top: -4px;
    bottom: -4px;
    width: 2px;
    background: var(--color-accent);
  }

  .today-mono-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-secondary);
    margin-top: var(--sp-1);
  }

  @media (max-width: 640px) {
    .today {
      padding: var(--sp-4);
    }

    .today-head {
      flex-direction: column;
      gap: var(--sp-1);
    }

    .today-body {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .today-year {
      border-left: none;
      border-top: 1px solid var(--color-border-light);
      padding-left: 0;
      padding-top: var(--sp-3);
    }
  }
</style>
