---
// Calculator.astro — interactive date calculator (only component with JS)
---
<div class="calc">
  <h2 class="calc-title">Calculate Days Between Dates</h2>
  <div class="calc-body">
    <div class="calc-inputs">
      <div class="calc-field">
        <label for="calc-date1">Start date</label>
        <input type="date" id="calc-date1" />
      </div>
      <span class="calc-sep" aria-hidden="true">→</span>
      <div class="calc-field">
        <label for="calc-date2">End date</label>
        <input type="date" id="calc-date2" />
      </div>
    </div>
    <div class="calc-output" id="calc-result" aria-live="polite"></div>
  </div>
</div>

<script>
  const d1 = document.getElementById('calc-date1') as HTMLInputElement;
  const d2 = document.getElementById('calc-date2') as HTMLInputElement;
  const result = document.getElementById('calc-result')!;

  const MS_PER_DAY = 86_400_000;

  function urlParams() {
    return new URLSearchParams(window.location.search);
  }

  // Keep the URL shareable: ?start=YYYY-MM-DD&end=YYYY-MM-DD
  function syncUrl() {
    const params = urlParams();
    if (d1.value) params.set('start', d1.value);
    else params.delete('start');
    if (d2.value) params.set('end', d2.value);
    else params.delete('end');
    const qs = params.toString();
    history.replaceState(null, '', qs ? window.location.pathname + '?' + qs : window.location.pathname);
  }

  function update() {
    if (!d1.value || !d2.value) {
      result.innerHTML = '';
      return;
    }
    const t1 = new Date(d1.value + 'T12:00:00').getTime();
    const t2 = new Date(d2.value + 'T12:00:00').getTime();
    const days = Math.abs(Math.round((t2 - t1) / MS_PER_DAY));
    const weeks = Math.floor(days / 7);
    const rem = days % 7;
    const dayLabel = days === 1 ? 'day' : 'days';
    const weekLabel = weeks === 1 ? 'week' : 'weeks';
    const remStr = rem ? ' and ' + rem + ' ' + (rem === 1 ? 'day' : 'days') : '';

    result.innerHTML =
      '<span class="calc-num">' + days.toLocaleString('en-US') + '</span>' +
      '<span class="calc-unit">' + dayLabel + '</span>' +
      '<p class="calc-sub">That\'s ' + weeks + ' ' + weekLabel + remStr + '</p>';

    syncUrl();
  }

  // Prefill from ?start=&end= so a shared URL reproduces the result
  const initial = urlParams();
  if (initial.get('start')) d1.value = initial.get('start')!;
  if (initial.get('end')) d2.value = initial.get('end')!;
  if (initial.get('start') || initial.get('end')) update();

  d1.addEventListener('change', update);
  d2.addEventListener('change', update);
</script>

<style>
  .calc {
    margin: var(--sp-6) 0;
  }

  .calc-title {
    font-size: var(--text-lg);
    font-weight: 650;
    text-align: center;
    margin-bottom: var(--sp-4);
  }

  .calc-body {
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: var(--sp-6);
    text-align: center;
  }

  .calc-inputs {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .calc-field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .calc-field label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    text-align: left;
  }

  .calc-field input {
    font-size: var(--text-base);
    padding: var(--sp-2) var(--sp-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    background: var(--color-bg);
    min-width: 170px;
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast);
  }

  .calc-field input:hover {
    border-color: var(--color-text-tertiary);
  }

  .calc-field input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-glow);
    outline: none;
  }

  .calc-sep {
    font-size: var(--text-xl);
    color: var(--color-text-tertiary);
    padding-bottom: var(--sp-2);
  }

  .calc-output {
    margin-top: var(--sp-5);
    min-height: 2rem;
  }

  .calc-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.15;
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  .calc-unit {
    display: block;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-accent);
    margin-top: var(--sp-1);
  }

  .calc-sub {
    margin-top: var(--sp-3);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .calc-body {
      padding: var(--sp-4);
    }

    .calc-inputs {
      flex-direction: column;
      align-items: stretch;
    }

    .calc-field input {
      width: 100%;
      min-width: 0;
    }

    .calc-sep {
      text-align: center;
      padding: 0;
    }

    .calc-num {
      font-size: 2rem;
    }
  }
</style>
