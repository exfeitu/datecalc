---
// Breadcrumb.astro — breadcrumb navigation with Schema.org
import { breadcrumbSchema } from '../lib/schema';

export interface BreadcrumbItem {
  name: string;
  url: string;
}

const { items } = Astro.props as { items: BreadcrumbItem[] };
const schema = breadcrumbSchema(items);
---
<nav aria-label="Breadcrumb" class="bc">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={item.url}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
        {i < items.length - 1 && <span class="bc-sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

<style>
  .bc {
    margin-bottom: var(--sp-5);
  }

  .bc ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    font-size: var(--text-sm);
  }

  .bc li {
    display: flex;
    align-items: center;
    color: var(--color-text-tertiary);
  }

  .bc a {
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .bc a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .bc-sep {
    margin: 0 var(--sp-2);
    color: var(--color-text-tertiary);
    user-select: none;
    font-weight: 300;
  }
</style>
