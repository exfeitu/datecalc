---
// Header.astro — site header with nav
const navLinks = [
  { href: '/days-between/', label: 'Days Between' },
  { href: '/days-from-today/', label: 'Days From Today' },
  { href: '/days-until/', label: 'Days Until' },
  { href: '/days-in/', label: 'Days In' },
];

const path = Astro.url.pathname;
---
<header class="sh">
  <a href="/" class="sh-logo" aria-label="DateCalc home">
    <span class="sh-logo-mark" aria-hidden="true"></span>
    <span class="sh-logo-word">DateCalc</span>
  </a>
  <nav aria-label="Main navigation" class="sh-nav">
    {navLinks.map(link => (
      <a
        href={link.href}
        class:list={{ 'is-active': path.startsWith(link.href) }}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .sh {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--sp-6);
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(246, 246, 244, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .sh-logo {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .sh-logo:hover {
    text-decoration: none;
  }

  /* Ruler-tick mark */
  .sh-logo-mark {
    width: 20px;
    height: 14px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--color-accent) 0 2px,
      transparent 2px 5px
    );
    opacity: 0.9;
  }

  .sh-logo-word {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .sh-logo:hover .sh-logo-word {
    color: var(--color-accent);
  }

  .sh-nav {
    display: flex;
    gap: var(--sp-1);
    flex-wrap: wrap;
  }

  .sh-nav a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: nowrap;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast),
                background var(--transition-fast);
  }

  .sh-nav a:hover {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    text-decoration: none;
  }

  .sh-nav a.is-active {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
  }

  @media (max-width: 640px) {
    .sh {
      flex-direction: column;
      gap: var(--sp-3);
      padding: var(--sp-3) 0;
      margin-bottom: var(--sp-4);
    }

    .sh-nav {
      gap: var(--sp-1) var(--sp-2);
      justify-content: center;
    }

    .sh-nav a {
      padding: var(--sp-1) var(--sp-2);
    }
  }
</style>
