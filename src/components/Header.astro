---
// Header.astro — site header with nav
const navLinks = [
  { href: '/days-between/', label: 'Days Between' },
  { href: '/days-from-today/', label: 'Days From Today' },
  { href: '/days-until/', label: 'Days Until' },
  { href: '/days-in/', label: 'Days In' },
];
---
<header class="sh">
  <a href="/" class="sh-logo" aria-label="DateCalc home">DateCalc</a>
  <nav aria-label="Main navigation" class="sh-nav">
    {navLinks.map(link => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
</header>

<style>
  .sh {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: var(--sp-6);
  }

  .sh-logo {
    font-size: var(--text-lg);
    font-weight: 750;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .sh-logo:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .sh-nav {
    display: flex;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }

  .sh-nav a {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: nowrap;
    padding: var(--sp-1) 0;
  }

  .sh-nav a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .sh {
      flex-direction: column;
      gap: var(--sp-3);
      padding: var(--sp-3) 0;
      margin-bottom: var(--sp-4);
    }

    .sh-nav {
      gap: var(--sp-3) var(--sp-4);
      justify-content: center;
    }
  }
</style>
