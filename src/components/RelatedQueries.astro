---
// RelatedQueries.astro — internal links block
export interface RelatedLink {
  href: string;
  label: string;
}

export interface Props {
  links: RelatedLink[];
  title?: string;
}

const { links, title = 'Related Calculations' } = Astro.props;
---
<nav class="rq" aria-label={title}>
  <h2 class="rq-title kicker">{title}</h2>
  <ul class="rq-list">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .rq {
    margin: var(--sp-8) 0;
    padding: var(--sp-6);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
  }

  .rq-title {
    margin-bottom: var(--sp-4);
    color: var(--color-text-tertiary);
  }

  .rq-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
  }

  .rq-list li {
    font-size: var(--text-sm);
  }

  .rq-list a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding: var(--sp-1) 0;
    font-weight: 500;
  }

  .rq-list a::after {
    content: '→';
    font-size: var(--text-xs);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .rq-list a:hover::after {
    opacity: 1;
    transform: translateX(0);
  }
</style>
