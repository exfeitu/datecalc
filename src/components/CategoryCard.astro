---
// CategoryCard.astro — home page category card (white instrument plate)
export interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---
<a href={href} class="cc">
  <div class="cc-tick" aria-hidden="true"></div>
  <div class="cc-body">
    <h3 class="cc-title">{title}</h3>
    <p class="cc-desc">{description}</p>
    <span class="cc-cta">Explore <span class="cc-arrow" aria-hidden="true">&rarr;</span></span>
  </div>
</a>

<style>
  .cc {
    display: flex;
    flex-direction: column;
    padding: var(--sp-6) var(--sp-5);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xs);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast),
                transform var(--transition-fast);
    position: relative;
    overflow: hidden;
  }

  /* Top accent tick — grows on hover */
  .cc-tick {
    position: absolute;
    top: 0;
    left: var(--sp-5);
    right: var(--sp-5);
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0.15);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .cc:hover .cc-tick {
    transform: scaleX(1);
  }

  .cc:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-sm);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .cc-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--sp-2);
    letter-spacing: -0.01em;
  }

  .cc:hover .cc-title {
    color: var(--color-accent);
  }

  .cc-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--sp-4);
    flex: 1;
  }

  .cc-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .cc-arrow {
    display: inline-block;
    color: var(--color-accent);
    transition: transform var(--transition-fast);
  }

  .cc:hover .cc-arrow {
    transform: translateX(4px);
  }
</style>
