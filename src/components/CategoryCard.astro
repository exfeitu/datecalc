---
// CategoryCard.astro — home page category card
export interface Props {
  title: string;
  description: string;
  href: string;
}

const { title, description, href } = Astro.props;
---
<a href={href} class="cc">
  <div class="cc-accent" aria-hidden="true"></div>
  <div class="cc-body">
    <h3 class="cc-title">{title}</h3>
    <p class="cc-desc">{description}</p>
    <span class="cc-cta" aria-hidden="true">Explore &rarr;</span>
  </div>
</a>

<style>
  .cc {
    display: flex;
    padding: var(--sp-5);
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast),
                transform var(--transition-fast);
    overflow: hidden;
    position: relative;
  }

  /* Left accent bar — visible on hover */
  .cc-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--color-accent);
    border-radius: 3px 0 0 3px;
    opacity: 0;
    transform: scaleY(0.6);
    transition: opacity var(--transition-fast),
                transform var(--transition-base);
  }

  .cc:hover .cc-accent {
    opacity: 1;
    transform: scaleY(1);
  }

  .cc-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .cc:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-accent);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .cc-title {
    font-size: var(--text-lg);
    font-weight: 650;
    color: var(--color-text);
    margin-bottom: var(--sp-1);
  }

  .cc:hover .cc-title {
    color: var(--color-accent);
  }

  .cc-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--sp-3);
    flex: 1;
  }

  .cc-cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    opacity: 0.5;
    transition: opacity var(--transition-fast);
  }

  .cc:hover .cc-cta {
    opacity: 1;
  }
</style>
