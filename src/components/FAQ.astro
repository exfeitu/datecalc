---
// FAQ.astro — FAQ block with Schema.org FAQPage
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FaqItem[];
  /** If provided, generates FAQPage schema for this URL */
  pageUrl?: string;
}

const { items, pageUrl } = Astro.props;
---
<section class="faq">
  <h2 class="faq-title kicker">Frequently Asked Questions</h2>
  <div class="faq-list">
    {items.map((faq) => (
      <details class="faq-item">
        <summary class="faq-q">{faq.question}</summary>
        <div class="faq-a">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    margin: var(--sp-8) 0;
  }

  .faq-title {
    font-size: var(--text-sm);
    margin-bottom: var(--sp-4);
    color: var(--color-text-tertiary);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .faq-item {
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    background: var(--color-card);
    box-shadow: var(--shadow-xs);
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast),
                background var(--transition-fast);
  }

  .faq-item:hover {
    border-color: var(--color-border);
  }

  .faq-item[open] {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    background: var(--color-card);
  }

  .faq-q {
    padding: var(--sp-4) var(--sp-5);
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    list-style: none;
    color: var(--color-text);
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q::after {
    content: '+';
    flex-shrink: 0;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-tertiary);
    width: 24px;
    height: 24px;
    text-align: center;
    line-height: 22px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg);
    transition: transform var(--transition-fast),
                background var(--transition-fast),
                color var(--transition-fast),
                border-color var(--transition-fast);
  }

  .faq-item[open] .faq-q::after {
    content: '−';
    color: #fff;
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .faq-a {
    padding: 0 var(--sp-5) var(--sp-4);
  }

  .faq-a p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: 0;
  }
</style>
