---
// FAQ.astro — FAQ block with Schema.org FAQPage
import { resultPageSchema } from '../lib/schema';

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  items: FaqItem[];
  /** If provided, generates FAQPage schema for this URL */
  pageUrl?: string;
}

const { items, pageUrl } = Astro.props;
---

<section class="faq">
  <h2>Frequently Asked Questions</h2>
  <dl>
    {items.map((faq) => (
      <details>
        <summary>{faq.question}</summary>
        <p>{faq.answer}</p>
      </details>
    ))}
  </dl>
</section>

<style>
  .faq {
    margin: 2rem 0;
  }

  .faq h2 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .faq dl {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq details {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    background: var(--color-card-bg);
    cursor: pointer;
  }

  .faq details[open] {
    background: var(--color-bg);
  }

  .faq summary {
    font-weight: 500;
    font-size: 0.9375rem;
    user-select: none;
  }

  .faq summary::marker {
    color: var(--color-accent);
  }

  .faq p {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
</style>
