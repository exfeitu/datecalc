---
// DateContext.astro — date contextual information with visual cards
import { getWeekday, isLeapYear } from '../lib/dates';
import { formatDateLong } from '../lib/formatters';

export interface Props {
  date1: string;
  date2: string;
  days: number;
  showYearContext?: boolean;
}

const { date1, date2, days, showYearContext = true } = Astro.props;
const weekday1 = getWeekday(date1);
const weekday2 = getWeekday(date2);
const year1 = parseInt(date1.slice(0, 4));
const year2 = parseInt(date2.slice(0, 4));
const weeks = Math.floor(days / 7);
const remDays = days % 7;
---
<div class="dc">
  <div class="dc-cards">
    <div class="dc-card">
      <span class="dc-label">From</span>
      <span class="dc-date">{formatDateLong(date1)}</span>
      <span class="dc-wk">{weekday1}</span>
    </div>

    <div class="dc-connector">
      <span class="dc-days">{days.toLocaleString('en-US')} day{days === 1 ? '' : 's'}</span>
      <svg class="dc-arrow" width="48" height="12" viewBox="0 0 48 12" aria-hidden="true">
        <line x1="0" y1="6" x2="42" y2="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3" />
        <polyline points="40,2 46,6 40,10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>

    <div class="dc-card">
      <span class="dc-label">To</span>
      <span class="dc-date">{formatDateLong(date2)}</span>
      <span class="dc-wk">{weekday2}</span>
    </div>
  </div>

  <p class="dc-breakdown">
    That's <strong>{weeks} week{weeks === 1 ? '' : 's'}</strong>{remDays > 0 && <span> and <strong>{remDays} day{remDays === 1 ? '' : 's'}</strong></span>}.
  </p>

  {showYearContext && (
    <p class="dc-year">
      {year1 === year2 ? (
        isLeapYear(year1)
          ? <>{year1} is a leap year — it has 366 days with an extra day on February 29.</>
          : <>{year1} is a common year with the usual 365 days.</>
      ) : (
        <>{year1} has {isLeapYear(year1) ? 366 : 365} days; {year2} has {isLeapYear(year2) ? 366 : 365} days. Leap years add a day every four years.</>
      )}
    </p>
  )}
</div>

<style>
  .dc {
    margin: var(--sp-6) 0 var(--sp-8);
  }

  .dc-cards {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .dc-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--color-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    padding: var(--sp-4) var(--sp-6);
    min-width: 170px;
    transition: box-shadow var(--transition-base);
  }

  .dc-card:hover {
    box-shadow: var(--shadow-sm);
  }

  .dc-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--sp-1);
  }

  .dc-date {
    font-weight: 650;
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .dc-wk {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  .dc-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
  }

  .dc-days {
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .dc-arrow {
    color: var(--color-border);
    width: 48px;
    height: 12px;
  }

  .dc-breakdown {
    text-align: center;
    margin-top: var(--sp-5);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  .dc-breakdown strong {
    color: var(--color-text);
    font-weight: 650;
  }

  .dc-year {
    text-align: center;
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  @media (max-width: 640px) {
    .dc-cards {
      flex-direction: column;
      gap: var(--sp-3);
    }

    .dc-card {
      width: 100%;
      max-width: 300px;
      padding: var(--sp-3) var(--sp-5);
    }

    .dc-date {
      font-size: var(--text-lg);
    }

    .dc-wk {
      font-size: var(--text-base);
      color: var(--color-text);
    }

    .dc-connector {
      flex-direction: row;
      gap: var(--sp-3);
    }

    .dc-arrow {
      width: 12px;
      height: 24px;
      transform: rotate(90deg);
    }

    .dc-arrow line {
      /* keep the arrow visible on the rotated svg */
    }
  }
</style>
