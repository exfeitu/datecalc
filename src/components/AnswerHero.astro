---
// AnswerHero.astro — large-format answer display for programmatic pages
export interface Props {
  value: number;
  unit: string;      // "days", "weeks", etc.
  subtitle?: string; // "That's 52 weeks and 1 day"
}

const { value, unit, subtitle } = Astro.props;
---
<div class="answer-hero">
  <span class="answer-value">{value.toLocaleString('en-US')}</span>
  <span class="answer-unit">{unit}</span>
  {subtitle && <p class="answer-subtitle">{subtitle}</p>}
  <slot />
</div>

<style>
  .answer-hero {
    text-align: center;
    padding: 2rem 0 1.5rem;
  }

  .answer-value {
    display: block;
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--color-accent);
  }

  .answer-unit {
    display: block;
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-top: 0.25rem;
  }

  .answer-subtitle {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: var(--color-text-secondary);
  }
</style>
