---
// AnswerHero.astro — signature large-format answer display
export interface Props {
  value: number;
  unit: string;
  subtitle?: string;
}

const { value, unit, subtitle } = Astro.props;
---
<div class="hero">
  <div class="hero-number" aria-label={`${value.toLocaleString('en-US')} ${unit}`}>
    <span class="hero-value">{value.toLocaleString('en-US')}</span>
    <span class="hero-unit">{unit}</span>
  </div>
  <div class="hero-accent" aria-hidden="true"></div>
  {subtitle && <p class="hero-sub">{subtitle}</p>}
  <slot />
</div>

<style>
  .hero {
    text-align: center;
    padding: var(--sp-10) 0 var(--sp-6);
    position: relative;
  }

  .hero-number {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .hero-value {
    display: block;
    font-family: var(--font-mono);
    font-size: clamp(3.25rem, 10vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-text);
    font-feature-settings: "tnum";
    font-variant-numeric: tabular-nums;
  }

  .hero-unit {
    display: block;
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-accent);
    margin-top: var(--sp-1);
    letter-spacing: 0.02em;
  }

  .hero-accent {
    width: 48px;
    height: 3px;
    margin: var(--sp-5) auto 0;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent),
      var(--color-accent-hover)
    );
    opacity: 0.7;
  }

  .hero-sub {
    margin-top: var(--sp-4);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--sp-8) 0 var(--sp-4);
    }

    .hero-value {
      font-size: clamp(2.25rem, 12vw, 3.5rem);
    }

    .hero-unit {
      font-size: var(--text-lg);
    }
  }
</style>
