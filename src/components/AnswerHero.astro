---
// AnswerHero.astro — signature instrument readout with measuring ruler
export interface Props {
  value: number;
  unit: string;
  /** Page <h1> question rendered above the readout (SEO: every page needs exactly one h1). */
  heading?: string;
  subtitle?: string;
}

const { value, unit, subtitle, heading } = Astro.props;
const label = `${value.toLocaleString('en-US')} ${unit}`;
---
<div class="hero">
  {heading && <h1 class="hero-heading">{heading}</h1>}
  <p class="hero-kicker">Result</p>
  <div class="hero-number" aria-label={label}>
    <span class="hero-value num">{value.toLocaleString('en-US')}</span>
    <span class="hero-unit">{unit}</span>
  </div>

  <!-- Measuring ruler — the signature -->
  <div class="hero-ruler" aria-hidden="true">
    <span class="hero-ruler-ticks"></span>
    <span class="hero-ruler-marker"></span>
  </div>

  {subtitle && <p class="hero-sub">{subtitle}</p>}
  <slot />
</div>

<style>
  .hero {
    text-align: center;
    padding: var(--sp-10) 0 var(--sp-6);
    position: relative;
  }

  .hero-heading {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 4.5vw, 1.9rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0 auto var(--sp-4);
    max-width: 560px;
    text-wrap: balance;
  }

  .hero-kicker {
    margin-bottom: var(--sp-3);
  }

  .hero-number {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .hero-value {
    display: block;
    font-size: clamp(3.5rem, 11vw, 6rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-text);
    text-shadow: 0 1px 0 var(--color-border-light);
  }

  .hero-unit {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-accent);
    margin-top: var(--sp-2);
    letter-spacing: 0.01em;
  }

  /* Measuring ruler: tick row + baseline + blue needle */
  .hero-ruler {
    position: relative;
    width: min(340px, 86%);
    height: 20px;
    margin: var(--sp-6) auto 0;
  }

  .hero-ruler-ticks {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 9px;
    background-image: repeating-linear-gradient(
      90deg,
      var(--color-text-tertiary) 0 1px,
      transparent 1px 6px
    );
  }

  .hero-ruler-marker {
    position: absolute;
    left: 50%;
    top: -1px;
    transform: translateX(-50%);
    width: 2px;
    height: 11px;
    background: var(--color-accent);
    box-shadow: 0 1px 4px var(--color-accent-glow);
  }

  .hero-ruler::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 9px;
    height: 1px;
    background: var(--color-border);
  }

  .hero-sub {
    margin-top: var(--sp-4);
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--sp-8) 0 var(--sp-4);
    }

    .hero-value {
      font-size: clamp(2.5rem, 14vw, 4rem);
    }

    .hero-unit {
      font-size: var(--text-lg);
    }

    .hero-ruler {
      width: min(280px, 92%);
      margin-top: var(--sp-5);
    }
  }
</style>
